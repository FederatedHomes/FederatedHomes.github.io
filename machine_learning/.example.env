# FederatedHomes deployment environment
# Copy this file to .env. The same deployment model is used for local
# distributed development and production. Local development uses starter
# credentials generated by setup.sh; production must use federation-approved
# TLS and SuperNode authentication credentials.
DEPLOYMENT_PROFILE=production

# Host role: server or client.
DEPLOYMENT_ROLE=server
# Required on client hosts; set to the client ID assigned to this machine.
CLIENT_ID=

# Server host's LAN DNS name or IP. Do not use the Docker-only hostname
# 'superlink' for a physical client host.
# Framework-managed Flower ports: Fleet 9092, Control 9093, Runtime 9091.
SUPERLINK_HOST=fl.example.internal

# TLS material paths inside Flower containers.
TLS_ROOT_CERTIFICATES=/etc/flower/tls/ca.crt
SUPERLINK_CERTIFICATE=/etc/flower/tls/superlink.crt
SUPERLINK_PRIVATE_KEY=/etc/flower/tls/superlink.key
TLS_CERTIFICATE_HOST_DIR=./certificates/tls

# SuperNode authentication paths.
SUPERNODE_AUTH_PRIVATE_KEY_DIR=/etc/flower/auth
SUPERNODE_AUTH_HOST_DIR=./certificates/auth

# Persistent SuperLink state; required on the server host.
SUPERLINK_STATE_HOST_DIR=./state/superlink
SUPERLINK_STATE_DIR=/var/lib/flower

# Client-host-local data paths. These describe only the machine running the
# selected client and therefore do not belong in clients.yml.
DATA_DIR=./data
CHECKPOINT_DIR=./checkpoints

# Application/runtime settings
SERVER_PORT=8080
SERVER_ADDRESS=server:8080
BATCH_SIZE=32
MODEL_BASE_NAME=final_model.pt
GLOBAL_MODEL_PREFIX=global
CLIENT_MODEL_PREFIX=client
METRICS_BASE_NAME=final_metrics.json
TRAIN_DATA_FILE=train.csv
VAL_DATA_FILE=val.csv
